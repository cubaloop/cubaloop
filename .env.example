# Never commit real credentials. Configure these in your hosting secret manager.
APP_URL=http://127.0.0.1:8765
JOTA_DATA_DIR=/workspace/cubaloop/.local/data
JOTA_BIND=127.0.0.1
# Optional proposal generation. Account-level consent is requested for every generation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Use Stripe test credentials until the full billing flow is verified.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
# Must be a real runtime secret, not a proxy placeholder: HMAC validation happens locally.
STRIPE_WEBHOOK_SECRET=
